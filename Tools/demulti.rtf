\ul Convert BAM to FASTQ\ulnone \
picard SamToFastq\
	INPUT=--.bam							the unmapped bam from previous step\
	FASTQ=<output.R1.fastq>\
	SECOND_END_FASTQ<output.R2.fastq>\
	INCLUDE_NON_PF_READS=false		include reads that did not pass filters\
	CLIPPING_ATTRIBUTE=XT\
	CLIPPING_ACTION=N					change base qualities at XT positions to N (a low number)\
					=X					clip the bases}