\f0\b\fs24 \cf0 mplieup\

\f1\b0\fs20 piles up reads per base:\
				\
\pard\tx566\tx1133\tx1700\tx2267\tx2834\tx3401\tx3968\tx4535\tx5102\tx5669\tx6236\tx6803\pardirnatural\partightenfactor0

\f0\b \cf0 general command:	
\f1\b0 \
	$ samtools mplieup .bam1 .bam2 -O .mpileup\
\

\f0\b output:
\f1\b0 \
	$1				chromosome\
	$2				1-based coordinate\
	$3				reference base (if provided by -f option)\
	$4				read depth at position\
	$5				bases of reads (., if reference base is provided)\
					^] is base at start of read\
					$ is base at end of read\
	$6				mapping quality per read\

\f0\b for several inputs:
\f1\b0 \
	$7-9				like $4-$6 for other sample  	\
\

\f0\b options:
\f1\b0 \
	-B --no-BAQ			BAQ file\
	-d --max-depth		maximum per file depth\
	-q INT				minimum map quality\
	-Q INT			minimum base quality\
	-f REFgene			outputs the ref base in $3 (otherwise N)\
					output is . for positive strand match and , for negative strand match	\
}