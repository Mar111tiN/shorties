\fs24 \cf0 PIPELINE to get UMI-information and to call consensus reads\
\

\f0\b 0. Create clean bam\
	
\f1\b0 proper mate pair tags are set using the GATK best practices pipeline:\
\
0.A.	\ul convert fastq to uBam\ulnone \
	$ picard FastqToSam \
		FASTQ=fastq.R1		files can be compressed\
		FASTQ2=fastq.R2		files can be compressed\
		OUTPUT=output.bam\
		READ_GROUP_NAME=<read_group>\
		SAMPLE_NAME=<sample_name>\
		LIBRARY_NAME=<???>\
		PLATFORM=illumina\
\
	or directly use the umi-tag for fgbio FastqToSam\
	$ fgbio FastqToSam R1.fastq R2.fastq index.fastq\
		--read-structure +T +T +M		+T all sample +M all UMI\
		--read-group-id=<RGID>\
		--sample=<sample>\
		--platform=illumina\
		--platform_unit=<flowcell-barcode.lane.sample_barcode>\
		--library=<library_name>\
	Tags:\
		RX:Z:					UMI-Sequence\
\
0.B \ul mark adapter sequences\ulnone \
	$ 
\f0\b picard MarkIlluminaAdapters
\f1\b0 \
		I=ubam.bam\
		O=adapter.bam\
		M=name_of_metrix.txt\
		TMP_DIR=$TMP_DIR\
\cf4 \cb5 		\CocoaLigature0 use_jdk_deflater=true use_jdk_inflater=true	to prevent SIGSEV fatal error\cf0 \cb1 \CocoaLigature1 \
	if you have non-standard adapters:\
		ADAPTERS="null"\
		FIVE_PRIME_ADAPTER=<seq_of_adapter>\
		THREE_PRIME_ADAPTER=<seq_of_adapter>\
	Tags:\
		XT:i:					3'-base start of illumina adapter\
\
\
0.\ul A+B\ulnone \
	$ picard FastqToSam \{params\} OUTPUT=/dev/stdout | picard MarkIlluminaAdapters I=/dev/stdin \{params\}\
\
\
\
\
\ul 0.C convert back to fastq\ulnone \
	$ 
\f0\b picard SamToFastq
\f1\b0 \
		I=adapter.bam\
		FASTQ=output.fastq 		this fastq-file is interleaved \
		CLIPPING_ATTRIBUTE=XT\
		CLIPPING_ACTION=2		base-quality of clipped bases is set to 2\
		INTERLEAVE=TRUE		to produce interleaved fastq (for piping)\
		NON_PF=true			retain below quality reads marked with 0x200\
							not really neccessary\
		TMP_DIR=$TMP_DIR\
\
0.D \ul align reads and flag secondary hits\ulnone \
	$ 
\f0\b bwa mem
\f1\b0  \
		-M	flags shorter hits as secondary\
		-p	use interleaved fastq\
		-t	threads\
		> aligned.sam\
\
	Tags:\
		AS:i					alignment score\
\
		NM:i					edit distance\
		MD:Z					mismatch bases\
\
		MC:Z					mate cigar\
\
		XA:Z					secondary alignment\
		XS:i					secondary alignment score\
\
0. \ul E merge aligned bam to uBAM and add mate tags\ulnone \
	$ 
\f0\b picard MergeBamAlignment
\f1\b0 \
		R=<ref_genome>\
		UNMAPPED_BAM=ubam.bam\
		ALIGNED_BAM=aligned.bam\
		O=merged.sam\
		CREATE_INDEX=True\
		ADD_MATE_CIGAR=true\
		CLIP_ADAPTERS=false\
		CLIP_OVERLAPPING_READS=true			I think it would be better to retain them for UMI-grouping\
		INCLUDE_SECONDARY_ALIGNMENTS=true\
		MAX_INSERTION_OR_DELETIONS=-1			allow any number\
		PRIMARY_ALIGNMENT_STRATEGY=MostDistant	# changed from BestMapq\
		ATTRIBUTES_TO_RETAIN=XS\
		TMP_DIR=$TMP_DIR\
	Tags:\
		MQ:i					alignment score\
		UQ:i					phred likelihood of segment\
\
		MC:Z	A				mate cigar\
		MQ:i					mapping quality of mate\
\
\
