\f0\b flow
\f1\b0 	\
	if (conditional) statement \
	else statement\
	while (conditional) statement\
	\
	for (i=1; i <=10; i++) statement\
	for (var in array) statement\
	break\
	continue\
	next 				skip remaining patterns on input line\
	exit [expression]		exit immediately (with expression result as exit status)\
	return expression \
	in most cases, an if statement can be replaced by using the pattern syntax\
	if statement might be more verbose\
\

\f0\b special variables:
\f1\b0 \
	$0				the entire line\
	$1 \'97 $n			field n in line (<99)\
	FS				input field separator, can be more than one char\
		FS=":"			changes field separator from " " to :\
	OFS				output field separator\
	NF				number of fields in current line\
	NR				number of lines in file\
	RS				record separator (sets the separator between lines (records = \\n)\
	ORS				output record separator\
	FILENAME			the current file name being read\
	\

\f0\b associative arrays\
\
functions:
\f1\b0 \
	print string, string;		prints strings separated by OFS and appended by \\n\
	printf(format, placeholders)	prints a string substituting %_ in format by placeholders (does not append \\n)\
		 \
	rand()				random number 0<n<1\
	length(string)			obvious\
	index(string, substr)		search for substr in string: returns position number or -1\
	substr(string, pos, [length])	extracts substring from string starting at pos until the end [length]\
	split(string, array, separator)	splits string at separator and stores elements in array\
		eg('G:H:TR:50', result, ':')	--> result is array containing ['G','H','TR',50]  , array[3] == 'TR'\
	sub(/old/,'new', string)		replaces pattern /old/ with string 'new' in place in given string and returns \
					non-zero if match is found (can be used as condition)\
					default for string is $0\
	gsub()				like sub but substitutes all occurrences on line\
	match(string, /pattern/)		returns non-zero if match is found in string and sets two variables\
		RSTART		start position of /pattern/ on string\
		RLENGTH		length of match\
		before = substr(string,1 RSTART-1)\
		match = substr(string, RSTART, RLENGTH)\
		after = substr(string, RSTART+RLENGTH)\
	function <name> ( param ) \{	custom function can be called with <name>(var)\
		action;\
	\}\
