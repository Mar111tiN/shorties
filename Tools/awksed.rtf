\cf2 \expnd0\expndtw0\kerning0
	#!/bin/sh\
	sed -n '\
	# if an empty line, check the paragraph\
	/^$/ b para\
	# else add it to the hold buffer\
	H\
	# at end of file, check paragraph\
	$ b para\
	# now branch to end of script\
	b\
	# this is where a paragraph is checked for the pattern\
	:para\
	# return the entire paragraph\
	# into the pattern space\
	x\
	# look for the pattern, if there - print\
	/'$1'/ p\
	'\
\

\f0\b\fs36 \ul awk
\fs24 \ulnone \

\f1\b0\fs20 line-oriented processor for rows and columns\

\f0\b awk one-liner
\f1\b0 \
	awk 'pattern \{action\}' file1 file2	run awk on file1 and file2 and output to stdout -> can be piped\
\

\f0\b awk script
\f1\b0 \
	#!/bin/sh			ln -s to your bin and chmod +x and run by its name\
	var=$1				inject command options into awk commands\
	awk '\
	pattern \{\'a0action; expression(var) \}\
	pattern \{\'a0action \}\
	pattern \{\'a0action \}\
	'\
	in file write:			\
	pattern \{\'a0action \}\
	pattern \{\'a0action \}\
	pattern \{\'a0action \}		is called as $ awk -f script_name\
\
as awk executable:			use directly with its name\
	#!/bin/awk -f			full path to awk executable to use it as an interpretor\
	pattern \{\'a0action \}\
	pattern \{\'a0action \}\
	pattern \{\'a0action \}\
	pattern \{action\}			general pattern for an awk command\
\

\f0\b action syntax:\
	
\f1\b0 \\t				tab (works in AWK)\
	$n				the nth field in the input line\
	$0				the whole line\
	"$n"				variables in quotes will not be evaluated\
\

\f0\b patterns, ranges:\
	
\f1\b0 3				line 3 in file
\f0\b \

\f1\b0 	/regex/				shorthand for:
\f0\b \
	
\f1\b0 $0 ~ /regex/ \{action\}		full line matches /regex/\
	$n ~ /regex/ \{action\}		n-th column matches regex --> action\
	$n !~ /regex/ \{action\}		nth column does not match regex --> action\
	cond1 && cond2		different conditions can be logically combined with && and ||\
	cond1 || cond2\
		eg: $n ~\'a0 /regex/ || $m ~ /regex2/ \{action\}	\
		nth column matches regex and mth column matches regex2 --> action\
	\
 \
	\

\f0\b special patterns:
\f1\b0 \
	BEGIN \{ action	\}		things to happen before the first line\
	END \{action \}			after the last line\
	\{action\}				Null pattern (will be executed always)\
\
