\f0\b \cf0 address
\f1\b0 : 	\
	n				act only on line number n\
	n,k				from line n to line k\
	n,$				from line n to end\
	n~k				starting with n and then every k lines\
	adress,+n			line defined by address and n following lines\
	$				last line\
	/regexp/			lines matching a regexp\
	\\.regexp.			after backslash  you can define a delimiter\
	/^$/				empty lines\
	/regexp/,/regexp/		starting at match1 and ending at match2\
	sed '-n /regex/p'			acts like grep\
		adress!			every line except this address\
\

\f0\b commands:\
	!				
\f1\b0 reverses the command (effectively activating command on everything but the address\
	p				print the result (either again or only (if -n option)\
	q				exit sed\
	n				empty pattern space and read in new line (in same sed cycle of commands)\
	w file_name			write to file\
	r file_name			read from file \'97> include that file\
eg.	sed '/INCLUDE/ \{\
		r file			add file at a line with INCLUDE\
		d			remove the INCLUDE line\
	\}'				\
	d 				delete that line (in pattern space)\
	a 'line text'			add line after address\
	i 'line text'			insert line before address\
	c 'line text'			insert line at address and remove previous line text\
	s	s/regexp/replacement/	substitutes regex with replacement - / is an arbitrary delimiter\
	or	s_regexp_repl_		after s any delimiter can be set\
	or	s:regexp:repl		..in order to use / as literal search string\
		& in the command means the actual match:\
		's/^[a-z]+/(&)'		enclose any starting letter groups with parens\
		's/(regex)/\\1		\\1 means the first pattern marked by parens\
	!!!	's/\\(regex\\)/\\1		parens have to be escaped unless used with -r option\
		y/set1/set2		transliteration from set1 to set2\
\

\f0\b flags:
\f1\b0 	\
	/g				find all matches/ normally just the first match\
	/n				find and act on the n-th match\
	/4g				find and act on the 4th and all following matches on that line\
	/I				ignore case\
	\

\f0\b sed as script:
\f1\b0 				you can execute that script directly from CL by its name\
	#!/bin/sed -f\
	sed-command1\
	sed-command2\
	\
	#!/bin/sh			you can pass CL arguments into script using $1 etc\
	sed -n 's/'"$1"'/&/p'		make sure to turn quoting off when calling $n and then back on\
\

\f0\b multiline commands:\
	
\f1\b0 N				adds the next line to the pattern space separated with a \\n\
	following commands apply to the concatenated pattern space\
these commands have to be used properly with nested curly braces as a script:\
	#!/bin/sh\
	sed '\
	/pattern/ \{			if pattern is in address\
		N			add next line to pattern space with \\n\
		/pattern\\n.*pattern/ \{	now look in concatenated pattern space for that pattern\
			s/pattern\\n.*pattern/pattern pattern/	delete everything between patterns to white space\
			\}\
		\}' $1			CL argument passed as file\
	!!!	's/\\n/\\			in sed scripts new lines in patters are \\n \'97 in replacements they are \\ literals\
		'\
	D				deletes first part of pattern space (up to \\n) and starts new cycle\
					ignores any subsequent commands in group\
	P				prints the first part of pattern space (up to \\n) without changing the pattern space\
\

\f0\b using the hold space:\
	
\f1\b0 beside the pattern space, sed also carries the hold space allowing the storage of previous lines	initially, the hold space contains an empty line ^$
\f0\b \
	
\f1\b0 command:\
		h			copies pattern buffer into hold space\
		H			appends pattern buffer into hold space\
		g			copies hold buffer into pattern space (deletes pattern space)\
		G			appends hold buffer into pattern space\
		x			switch hold and pattern space		\
\

\f0\b flow control
\f1\b0 \
	:name 				mark a target point for the script to jump to (usually at the end)\
	b name				jumps to the target point marked with :name\
	b				jump to the end of the script\
	t name				jump to the target point if pattern space has been modified by last s command\
\
