\f0\b \cf0 options:
\f1\b0 \
	-n						only print stuff after p command\
	-r  / -E						use extended regex\
	-e command -e command		apply several commands to a line:\
	-e 's/regex/replace/' -e 's/regex/repl/\
	-f script					apply sed script\
	\
